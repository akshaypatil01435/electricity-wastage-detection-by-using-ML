# Copy to .env (never commit .env). For IntelliJ, set these as Run Configuration environment variables.

# ---- Backend (Spring Boot) ----
DB_URL=jdbc:mysql://localhost:3306/wattvision_db
DB_USERNAME=wattvision
DB_PASSWORD=
# docker compose only
MYSQL_ROOT_PASSWORD=
# shared secret Spring Boot -> FastAPI (leave empty for local dev)
ML_API_KEY=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@wattvision.ai
ADMIN_PASSWORD=

# ---- Frontend (put these in frontend/.env.local) ----
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_DEMO_MODE=true
